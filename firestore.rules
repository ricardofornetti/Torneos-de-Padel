rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'fornettiricardo@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isPlayerOwner(playerId) {
      return isSignedIn() && (
        playerId == request.auth.uid || 
        playerId == 'p_google_' + request.auth.uid
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isTournamentOpen(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status != 'completed';
    }

    // --- SCHEMA VALIDATION BLUEPRINTS ---
    function isValidTournament(t) {
      return t.keys().hasAll(['id', 'name', 'startDate', 'endDate', 'club', 'city', 'category', 'tournamentType', 'maxPairs', 'numGroups', 'numCourts', 'status'])
        && t.keys().size() == 12
        && t.id is string && t.id.size() <= 64
        && t.name is string && t.name.size() > 0 && t.name.size() <= 100
        && t.startDate is string && t.startDate.size() == 10
        && t.endDate is string && t.endDate.size() == 10
        && t.club is string && t.club.size() <= 100
        && t.city is string && t.city.size() <= 100
        && t.category is string && t.category.size() <= 50
        && t.tournamentType is string && t.tournamentType.size() <= 50
        && t.maxPairs is int && t.maxPairs > 0 && t.maxPairs <= 128
        && t.numGroups is int && t.numGroups >= 1 && t.numGroups <= 32
        && t.numCourts is int && t.numCourts >= 1 && t.numCourts <= 100
        && t.status is string && (t.status == 'registration' || t.status == 'in_progress' || t.status == 'completed');
    }

    function isValidPlayer(p) {
      return p.keys().hasAll(['id', 'firstName', 'lastName', 'city', 'category', 'rankingPoints', 'photoUrl', 'matchesPlayed', 'matchesWon', 'matchesLost', 'setsWon', 'setsLost', 'gamesWon', 'gamesLost'])
        && p.keys().size() == 14
        && p.id is string && p.id.size() <= 64
        && p.firstName is string && p.firstName.size() <= 50
        && p.lastName is string && p.lastName.size() <= 50
        && p.city is string && p.city.size() <= 50
        && p.category is string && p.category.size() <= 50
        && (p.rankingPoints is int || p.rankingPoints is float)
        && p.photoUrl is string && p.photoUrl.size() <= 2048
        && p.matchesPlayed is int
        && p.matchesWon is int
        && p.matchesLost is int
        && p.setsWon is int
        && p.setsLost is int
        && p.gamesWon is int
        && p.gamesLost is int;
    }

    function isValidPlayerPrivate(p) {
      return p.keys().hasAll(['id', 'dni', 'phone', 'email', 'birthDate'])
        && p.keys().size() == 5
        && p.id is string && p.id.size() <= 64
        && p.dni is string && p.dni.size() <= 20
        && p.phone is string && p.phone.size() <= 30
        && p.email is string && p.email.size() <= 100
        && p.birthDate is string && p.birthDate.size() <= 10;
    }

    function isValidPair(pr) {
      return pr.keys().hasAll(['id', 'tournamentId', 'player1Id', 'player2Id', 'category', 'combinedRanking', 'status'])
        && pr.keys().size() == 7
        && pr.id is string && pr.id.size() <= 64
        && pr.tournamentId is string && pr.tournamentId.size() <= 64
        && pr.player1Id is string && pr.player1Id.size() <= 64
        && pr.player2Id is string && pr.player2Id.size() <= 64
        && pr.category is string && pr.category.size() <= 50
        && (pr.combinedRanking is int || pr.combinedRanking is float)
        && pr.status is string && (pr.status == 'registered' || pr.status == 'waitlist' || pr.status == 'confirmed');
    }

    function isValidMatch(m) {
      return m.keys().hasAll(['id', 'tournamentId', 'phase', 'roundNumber', 'stageName', 'pair1Id', 'pair2Id', 'courtId', 'date', 'time', 'status', 'scoreSummary', 'winnerPairId'])
        && m.keys().size() >= 13 && m.keys().size() <= 15
        && m.id is string && m.id.size() <= 64
        && m.tournamentId is string && m.tournamentId.size() <= 64
        && m.phase is string && (m.phase == 'group' || m.phase == 'playoff')
        && m.roundNumber is int
        && m.stageName is string && m.stageName.size() <= 50
        && m.pair1Id is string && m.pair1Id.size() <= 64
        && m.pair2Id is string && m.pair2Id.size() <= 64
        && m.courtId is string && m.courtId.size() <= 64
        && m.date is string && m.date.size() <= 10
        && m.time is string && m.time.size() <= 5
        && m.status is string && (m.status == 'pending' || m.status == 'completed' || m.status == 'wo' || m.status == 'abandoned')
        && m.scoreSummary is string && m.scoreSummary.size() <= 100 && m.scoreSummary.matches('^[a-zA-Z0-9.\\- ]*$')
        && m.winnerPairId is string && m.winnerPairId.size() <= 64;
    }

    function isValidCourt(c) {
      return c.keys().hasAll(['id', 'name', 'club', 'active'])
        && c.keys().size() == 4
        && c.id is string && c.id.size() <= 64
        && c.name is string && c.name.size() > 0 && c.name.size() <= 100
        && c.club is string && c.club.size() <= 100
        && c.active is bool;
    }

    function isValidGalleryMedia(g) {
      return g.keys().hasAll(['id', 'url', 'type', 'createdAt'])
        && g.id is string && g.id.size() <= 64
        && g.url is string && g.url.size() <= 10000000
        && g.type is string && (g.type == 'photo' || g.type == 'video')
        && g.createdAt is string && g.createdAt.size() <= 64;
    }

    // --- COLLECTION MATCH BLOCKS ---

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true; // Public listings
      allow create: if isAdmin() && isValidId(tournamentId) && isValidTournament(incoming());
      allow update: if isAdmin() && isValidTournament(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Players
    match /players/{playerId} {
      // Allow general read for rankings & player listing profiles (No PII)
      allow read: if true;
      allow create: if isValidId(playerId) && (isPlayerOwner(playerId) || isAdmin()) && isValidPlayer(incoming());
      allow update: if (isPlayerOwner(playerId) || isAdmin()) && isValidPlayer(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Players Private Data (PII)
    match /playersPrivate/{playerId} {
      // Strict isolation: only the specific player owner or admins can read or write PII
      allow read: if isPlayerOwner(playerId) || isAdmin();
      allow create: if isValidId(playerId) && (isPlayerOwner(playerId) || isAdmin()) && isValidPlayerPrivate(incoming());
      allow update: if (isPlayerOwner(playerId) || isAdmin()) && isValidPlayerPrivate(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Pairs
    match /pairs/{pairId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(pairId)
        && isValidPair(incoming())
        && (isPlayerOwner(incoming().player1Id) || isPlayerOwner(incoming().player2Id) || isAdmin())
        // Enforce Orphanded Registration check: parent tournament and players must exist!
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId))
        && exists(/databases/$(database)/documents/players/$(incoming().player1Id))
        && exists(/databases/$(database)/documents/players/$(incoming().player2Id));

      allow update: if isValidPair(incoming()) && (
        isAdmin() || (
          // Normal players can clean or amend registration parameters but cannot bypass inscription limits/status
          isSignedIn()
          && (isPlayerOwner(incoming().player1Id) || isPlayerOwner(incoming().player2Id))
          && incoming().status == existing().status
          && incoming().diff(existing()).affectedKeys().hasOnly(['player1Id', 'player2Id', 'category', 'combinedRanking'])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && (isPlayerOwner(existing().player1Id) || isPlayerOwner(existing().player2Id)));
    }

    // Matches
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(matchId) && isValidMatch(incoming());
      // Prevent double scoring: settled matches can only be modified by admins.
      // Prevent score poisoning, path poisoning and invalid game status jumps.
      allow update: if (isAdmin() || (isSignedIn() && existing().status == 'pending' && isTournamentOpen(incoming().tournamentId)))
        && isValidMatch(incoming())
        && incoming().id == existing().id 
        && (
          isAdmin() || 
          incoming().diff(existing()).affectedKeys().hasOnly(['winnerPairId', 'scoreSummary', 'status', 'settledAt', 'date', 'time', 'courtId'])
        );
      allow delete: if isAdmin();
    }

    // Courts
    match /courts/{courtId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(courtId) && isValidCourt(incoming());
      allow update: if isAdmin() && isValidCourt(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Gallery Media
    match /galleryMedia/{mediaId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(mediaId) && isValidGalleryMedia(incoming());
      allow update: if isAdmin() && isValidGalleryMedia(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isValidId(notifId); // Allow creation by system processes
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }
  }
}
